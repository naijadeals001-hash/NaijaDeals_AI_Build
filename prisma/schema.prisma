  @@index([vendorId, status])
}

enum DriverStatus {
  pending
  approved
  suspended
}

enum RideStatus {
  requested
  driver_assigned
  driver_arriving
  in_progress
  completed
  cancelled
}

enum RidePaymentMethod {
  cash
  wallet
}

enum RidePaymentStatus {
  pending
  held
  paid
  refunded
  partially_refunded
}

model DriverProfile {
  id            String       @id @default(cuid())
  userId        String       @unique
  licenseNumber String
  status        DriverStatus @default(pending)
  vehicleClass  String       @default("economy")
  vehicleMake   String
  vehicleModel  String
  vehiclePlate  String
  active        Boolean      @default(true)
  suspendedReason String?
  /// NaijaDrive does not enrol every ride driver in food delivery automatically;
  /// they opt in explicitly and carry an insulated bag.
  foodDeliveryEnabled Boolean @default(false)
  /// motorcycle | car — mapped from vehicleClass for dispatch eligibility.
  foodVehicleType String    @default("car")
  serviceZone   String?
  online        Boolean      @default(false)
  insulatedBag  Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id])
  rides         Ride[]

  @@index([status, active])
}

model Ride {
  id                 String            @id @default(cuid())
  rideNumber         String            @unique
  riderId            String
  driverId           String?
  status             RideStatus        @default(requested)
  pickupLabel        String
  pickupAddress      String
  pickupLat          Float
  pickupLng          Float
  dropoffLabel       String
  dropoffAddress     String
  dropoffLat         Float
  dropoffLng         Float
  vehicleClass       String
  distanceMeters     Int
  durationMinutes    Int
  fareKobo           BigInt
  currency           String            @default("NGN")
  paymentMethod      RidePaymentMethod
  paymentStatus      RidePaymentStatus @default(pending)
  paymentReference   String?
  requestedAt        DateTime          @default(now())
  acceptedAt         DateTime?
  arrivedAt          DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  /**
   * When the assigned driver must make the next move before the ride returns to the
   * open queue. Set on acceptance, reset on arrival, cleared once the trip starts.
   * Null means no deadline (nothing assigned, or the trip is already moving).
   */
  assignmentExpiresAt DateTime?
  /** Retained from the fare hold when the rider cancels after the driver set off. */
  cancellationFeeKobo BigInt          @default(0)
  /**
   * Bounded pre-enforcement compatibility marker for protected pickup verification.
   *
   * Null for every ride assigned after enforcement. The enforcement migration set
   * this exactly once for rides that were already assigned (`driver_assigned` or
   * `driver_arriving`) and had no `RideVerification` record at that moment. It is
   * the only evidence that lets such an assignment start without a code; runtime
   * code must never set it. A missing record without this marker fails closed and
   * needs the audited support recovery action. Release, expiry, cancellation and
   * reassignment clear it so it can never authorise a later assignment.
   */
  pickupVerificationLegacyAt DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  rider              User              @relation("RiderRides", fields: [riderId], references: [id])
  driver             DriverProfile?    @relation(fields: [driverId], references: [id])
  events             RideEvent[]
  verification       RideVerification?
  ratings            RideRating[]
  safetyReports      RideSafetyReport[]

  @@index([riderId, status])
  @@index([driverId, status])
  @@index([status, createdAt])
  @@index([status, assignmentExpiresAt])
}

/// Participant roles for drive ratings and safety reports.
enum RideParticipantRole {
  customer
  driver
}

/// One protected pickup-verification record per ride.
///
/// The raw code is never stored in this table or in an event payload. It is
/// derived server-side from a per-ride random `salt` and a secret held outside
/// the database (HMAC-SHA256 keyed by `keyVersion`). Only the rider's
/// authenticated endpoint may read it. `codeHash` is a keyed (peppered) scrypt
/// hash used for constant-time comparison by the authoritative service.
model RideVerification {
  id                String    @id @default(cuid())
  rideId            String    @unique
  codeHash          String
  salt              String
  algorithm         String    @default("scrypt-hmac-sha256-v1")
  /// Server-secret key version used to derive and verify this code. NULL on
  /// records issued before server-keyed derivation: those are legacy salt-only
  /// rows that the runtime refuses to derive or verify and replaces on read,
  /// rider reset or support action. Never derive from a NULL version.
  keyVersion        Int?
  expiresAt         DateTime
  attemptCount      Int       @default(0)
  maxAttempts       Int       @default(5)
  lastAttemptAt     DateTime?
  verifiedAt        DateTime?
  verifiedByUserId  String?
  invalidatedAt     DateTime?
  invalidatedReason String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  ride              Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([verifiedAt])
}

/// One rating per participant per completed ride.
///
/// `raterRole` is derived from the authenticated account's relationship to the
/// ride, never from client input. There is no public testimonial surface: these
/// rows are read only by the two participants (their own rating) and by
/// aggregate calculation over real rows.
model RideRating {
  id            String             @id @default(cuid())
  rideId        String
  raterUserId   String
  raterRole     RideParticipantRole
  subjectUserId String
  score         Int
  feedback      String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  ride          Ride               @relation(fields: [rideId], references: [id], onDelete: Cascade)
  rater         User               @relation("RideRatingRater", fields: [raterUserId], references: [id])
  subject       User               @relation("RideRatingSubject", fields: [subjectUserId], references: [id])

  @@unique([rideId, raterUserId])
  @@index([subjectUserId, raterRole])
  @@index([rideId])
}

enum RideSafetyReportStatus {
  submitted
  under_review
  closed
}

/// Safety reports are an operational record, deliberately separate from ratings
/// and reviews. They are never shown as public testimonials.
model RideSafetyReport {
  id              String                @id @default(cuid())
  rideId          String
  reporterUserId  String
  reporterRole    RideParticipantRole
  category        String
  details         String
  status          RideSafetyReportStatus @default(submitted)
  reviewedAt      DateTime?
  reviewedByUserId String?
  resolutionNote  String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  ride            Ride                  @relation(fields: [rideId], references: [id], onDelete: Cascade)
  reporter        User                  @relation("RideSafetyReporter", fields: [reporterUserId], references: [id])

  @@index([rideId, createdAt])
  @@index([status, createdAt])
}

model RideEvent {
  id          String     @id @default(cuid())
  rideId      String
  status      RideStatus
  label       String
  description String
  actorId     String?
  createdAt   DateTime   @default(now())
  ride        Ride       @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId, createdAt])
}

/**
 * A rider's own nickname for a bookable Lagos landmark ("Mum's place", "Office").
