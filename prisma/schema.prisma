enum FoodOrderStatus {
  placed
  kitchen_accepted
  preparing
  ready_for_pickup
  courier_assigned
  picked_up
  delivered
  cancelled
}

enum DispatchOfferStatus {
  offered
  accepted
  declined
  expired
  withdrawn
}

/// One authoritative delivery job per food order. Offers are time-limited and
/// withdrawn once any provider accepts, so an order can never end up with two
/// riders or two settlements.
model FoodDispatch {
  id           String   @id @default(cuid())
  orderId      String   @unique
  status       String   @default("open") // open | assigned | completed | failed
  vehicleNeed  String   @default("motorcycle")
  attempts     Int      @default(0)
  assignedType String?  // courier | driver
  assignedId   String?
  pickupPin    String
  deliveryPin  String
  pickedUpAt   DateTime?
  deliveredAt  DateTime?
  settlementReference String? @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  order        FoodOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offers       DispatchOffer[]

  @@index([status])
}

model DispatchOffer {
  id           String              @id @default(cuid())
  dispatchId   String
  /// courier = NaijaSend provider, driver = NaijaDrive provider.
  providerType String
  providerId   String
  status       DispatchOfferStatus @default(offered)
  earningsKobo BigInt
  expiresAt    DateTime
  createdAt    DateTime            @default(now())
  dispatch     FoodDispatch        @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@unique([dispatchId, providerType, providerId])
  @@index([providerType, providerId, status])
}

model FoodOrder {
  id             String          @id @default(cuid())
  orderNumber    String          @unique
  customerId     String
  restaurantId   String
  courierId      String?
  status         FoodOrderStatus @default(placed)
  paymentStatus  String          @default("paid")
  subtotalKobo   BigInt
  totalKobo      BigInt
  currency       String          @default("NGN")
  deliveryAddress String
  contactName    String
  contactPhone   String
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  customer       User            @relation("CustomerFoodOrders", fields: [customerId], references: [id])
  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id])
  courier        Courier?        @relation(fields: [courierId], references: [id])
  dispatch       FoodDispatch?
  items          FoodOrderItem[]
  events         FoodOrderEvent[]

  @@index([customerId, createdAt])
  @@index([restaurantId, status])
}

model FoodOrderItem {
  id           String   @id @default(cuid())
  orderId      String
  menuItemId   String?
  name         String
  unitPriceKobo BigInt
  quantity     Int
  notes        String?
  order        FoodOrder @relation(fields: [orderId], references: [id])
}

model FoodOrderEvent {
  id        String          @id @default(cuid())
  orderId   String
  status    FoodOrderStatus
  note      String?
  actorId   String?
  createdAt DateTime        @default(now())
  order     FoodOrder       @relation(fields: [orderId], references: [id])

