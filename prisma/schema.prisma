enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

/// One refund attempt. The idempotency key makes provider retries safe.
model Refund {
  id                String       @id @default(cuid())
  orderId           String
  paymentId         String
  actorId           String
  amountKobo        BigInt
  status            RefundStatus @default(PENDING)
  reason            String
  idempotencyKey    String       @unique
  providerReference String?
  createdAt         DateTime     @default(now())
  completedAt       DateTime?
  order             Order        @relation(fields: [orderId], references: [id])
  payment           Payment      @relation(fields: [paymentId], references: [id])

  @@index([orderId, status])
}


/// Singleton admin-managed storefront configuration.
model StorefrontConfig {
  id        String   @id @default("default")
  config    Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}


/// Append-only, unapplied financial correction prepared for review.
model LedgerAdjustment {
  id            String    @id @default(cuid())
  adjustmentKey String    @unique
  status        String    @default("PREPARED")
  journal       Json
  references    Json
  preparedBy    String
  preparedAt    DateTime  @default(now())
  appliedAt     DateTime?
  appliedBy     String?
  postings      AccountPosting[]
}

/// Non-wallet accounting account (for example fixture equity). Its balance may be negative.
model LedgerAccount {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  kind        String
  balanceKobo BigInt           @default(0)
  createdAt   DateTime         @default(now())
  postings    AccountPosting[]
}

model AccountPosting {
  id             String          @id @default(cuid())
  accountId      String
  adjustmentId   String?
  transactionId  String
  direction      LedgerDirection
  amountKobo     BigInt
  memo           String
  createdAt      DateTime        @default(now())
  account        LedgerAccount   @relation(fields: [accountId], references: [id])
  adjustment     LedgerAdjustment? @relation(fields: [adjustmentId], references: [id])
  @@index([accountId])
  @@unique([adjustmentId, accountId])
}


/// Durable database identity used to gate live financial operations.
enum VerticalActivationStatus {
  DISABLED
  PREVIEW
  LIVE
}

/// Central service activation. GLOBAL overrides COUNTRY/CITY; the effective
/// state is computed by lib/services/core/vertical-activation.service.ts.
model VerticalActivation {
  id           String                   @id @default(cuid())
  verticalKey  String
  scopeType    String
  countryCode  String                   @default("")
  cityCode     String                   @default("")
  status       VerticalActivationStatus @default(DISABLED)
  reason       String?
  updatedById  String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  @@unique([verticalKey, scopeType, countryCode, cityCode])
  @@index([verticalKey])
}

model DatabaseClassification {
  id             String   @id @default("default")
  classification String   @default("UNKNOWN")
  updatedBy      String?
  updatedAt      DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// NaijaGigs — professional services marketplace
// ---------------------------------------------------------------------------

enum ServiceMode {
  LOCAL
  REMOTE
  PROJECT
}

enum ServicePricingType {
  HOURLY
  FIXED
  QUOTE
}

enum ProfessionalStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum ServiceListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  SUSPENDED
}

enum CustomerJobStatus {
  OPEN
  ASSIGNED
  CLOSED
  CANCELLED
}

enum JobProposalStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ServiceBookingStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum ServicePaymentStatus {
  UNPAID
  HELD
  RELEASED
  REFUNDED
}

enum ServiceReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum ServiceDisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum GigMilestoneStatus {
  PENDING
  SUBMITTED
  APPROVED
  RELEASED
}

/// A vetted professional operating in the NaijaDeals services marketplace.
model ProfessionalProfile {
  id              String             @id @default(cuid())
  userId          String             @unique
  displayName     String
  headline        String
  bio             String
  avatarUrl       String?
  countryCode     String             @default("NG")
  state           String
  city            String
  serviceModes    ServiceMode[]
  languages       String[]           @default([])
  yearsExperience Int?
  status          ProfessionalStatus @default(PENDING)
  verifiedAt      DateTime?
  published       Boolean            @default(false)
  responseMinutes Int?
  commissionBps   Int                @default(1200)
  suspendedReason String?
  isSample        Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id])
  categories      ProfessionalCategory[]
  listings        ServiceListing[]
  portfolio       PortfolioItem[]
  serviceAreas    ServiceArea[]
  availability    AvailabilitySlot[]
  proposals       JobProposal[]
  bookings        ServiceBooking[]

  @@index([countryCode, city])
  @@index([status, published])
}

model ProfessionalCategory {
  professionalId String
  categoryId     String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])
  category       ServiceCategory     @relation(fields: [categoryId], references: [id])

  @@id([professionalId, categoryId])
}

/// Admin-managed service taxonomy shown on the NaijaGigs landing page and filters.
model ServiceCategory {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  icon        String    @default("Wrench")
  accent      String    @default("#0f7a4a")
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  /// Null means every enabled country; otherwise the category is country-specific.
  countryCode String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  professionals ProfessionalCategory[]
  listings      ServiceListing[]
  jobs          CustomerJob[]
  portfolio     PortfolioItem[]
  spotlights    ServiceSpotlight[]
  bookings      ServiceBooking[]

  @@index([isActive, sortOrder])
}

model ServiceListing {
  id             String               @id @default(cuid())
  isSample       Boolean              @default(false)
  professionalId String
  categoryId     String
  title          String
  slug           String               @unique
  summary        String
  description    String
  mode           ServiceMode
  pricingType    ServicePricingType
  priceKobo      BigInt?
  currency       String               @default("NGN")
  countryCode    String               @default("NG")
  state          String?
  city           String?
  isRemote       Boolean              @default(false)
  status         ServiceListingStatus @default(DRAFT)
  isFeatured     Boolean              @default(false)
  moderationNote String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  professional   ProfessionalProfile  @relation(fields: [professionalId], references: [id])
  category       ServiceCategory      @relation(fields: [categoryId], references: [id])
  images         ServiceListingImage[]
  packages       ServicePackage[]
  bookings       ServiceBooking[]

  @@index([status, mode, countryCode])
  @@index([categoryId, status])
}

model ServiceListingImage {
  id        String         @id @default(cuid())
  listingId String
  url       String
  alt       String
  sortOrder Int            @default(0)
  listing   ServiceListing @relation(fields: [listingId], references: [id])

  @@index([listingId, sortOrder])
}

model ServicePackage {
  id           String         @id @default(cuid())
  listingId    String
  name         String
  description  String
  priceKobo    BigInt
  deliveryDays Int
  revisions    Int            @default(1)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  listing      ServiceListing @relation(fields: [listingId], references: [id])

  @@index([listingId, isActive])
}

model PortfolioItem {
  id             String           @id @default(cuid())
  professionalId String
  categoryId     String?
  title          String
  description    String?
  imageUrl       String
  createdAt      DateTime         @default(now())
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])
  category       ServiceCategory?  @relation(fields: [categoryId], references: [id])

  @@index([professionalId])
}

model ServiceArea {
  id             String             @id @default(cuid())
  professionalId String
  countryCode    String
  state          String
  city           String?
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])

  @@index([professionalId])
  @@index([countryCode, state])
}

model AvailabilitySlot {
  id             String             @id @default(cuid())
  professionalId String
  /// 0 = Sunday … 6 = Saturday.
  weekday        Int
  startMinute    Int
  endMinute      Int
  timezone       String             @default("Africa/Lagos")
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])

  @@index([professionalId, weekday])
}

/// A customer-posted brief that professionals can answer with proposals.
model CustomerJob {
  id          String            @id @default(cuid())
  customerId  String
  categoryId  String?
  title       String
  description String
  mode        ServiceMode
  budgetKobo  BigInt?
  currency    String            @default("NGN")
  countryCode String            @default("NG")
  state       String
  city        String?
  status      CustomerJobStatus @default(OPEN)
  deadline    DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  customer    User              @relation("GigCustomerJobs", fields: [customerId], references: [id])
  category    ServiceCategory?  @relation(fields: [categoryId], references: [id])
  proposals   JobProposal[]
  bookings    ServiceBooking[]

  @@index([status, countryCode])
  @@index([customerId])
}

model JobProposal {
  id             String             @id @default(cuid())
  jobId          String
  professionalId String
  amountKobo     BigInt
  currency       String             @default("NGN")
  message        String
  deliveryDays   Int
  status         JobProposalStatus  @default(SUBMITTED)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  job            CustomerJob        @relation(fields: [jobId], references: [id])
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])

  @@unique([jobId, professionalId])
  @@index([professionalId, status])
}

model ServiceBooking {
  id             String               @id @default(cuid())
  reference      String               @unique
  customerId     String
  professionalId String
  professionalProfileId String
  listingId      String?
  jobId          String?
  categoryId     String?
  mode           ServiceMode
  title          String
  description    String?
  status         ServiceBookingStatus @default(REQUESTED)
  scheduledAt    DateTime?
  address        String?
  countryCode    String               @default("NG")
  state          String
  city           String?
  amountKobo     BigInt
  currency       String               @default("NGN")
  commissionBps  Int                  @default(1200)
  paymentStatus  ServicePaymentStatus @default(UNPAID)
  acceptedAt     DateTime?
  submittedAt    DateTime?
  completedAt    DateTime?
  cancelledReason String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  customer       User                  @relation("GigCustomerBookings", fields: [customerId], references: [id])
  professional   User                  @relation("GigProfessionalBookings", fields: [professionalId], references: [id])
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id])
  listing        ServiceListing?       @relation(fields: [listingId], references: [id])
  job            CustomerJob?          @relation(fields: [jobId], references: [id])
  category       ServiceCategory?      @relation(fields: [categoryId], references: [id])
  milestones     BookingMilestone[]
  conversation   Conversation?
  review         ServiceReview?
  disputes       ServiceDispute[]

  @@index([customerId, status])
  @@index([professionalId, status])
  @@index([paymentStatus])
}

model BookingMilestone {
  id          String             @id @default(cuid())
  bookingId   String
  title       String
  amountKobo  BigInt
  dueAt       DateTime?
  status      GigMilestoneStatus @default(PENDING)
  note        String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  booking     ServiceBooking     @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
}

model Conversation {
  id             String            @id @default(cuid())
  bookingId      String?           @unique
  jobId          String?
  customerId     String
  professionalId String
  createdAt      DateTime          @default(now())
  lastMessageAt  DateTime          @default(now())
  booking        ServiceBooking?   @relation(fields: [bookingId], references: [id])
  customer       User              @relation("GigCustomerConversations", fields: [customerId], references: [id])
  professional   User              @relation("GigProfessionalConversations", fields: [professionalId], references: [id])
  messages       Message[]

  @@index([customerId, lastMessageAt])
  @@index([professionalId, lastMessageAt])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  attachmentUrl  String?
  readAt         DateTime?
  createdAt      DateTime      @default(now())
  conversation   Conversation  @relation(fields: [conversationId], references: [id])
  sender         User          @relation("GigMessageSender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model ServiceReview {
  id             String              @id @default(cuid())
  bookingId      String              @unique
  customerId     String
  professionalId String
  rating         Int
  comment        String
  status         ServiceReviewStatus @default(PENDING)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  booking        ServiceBooking      @relation(fields: [bookingId], references: [id])
  customer       User                @relation("GigReviewAuthor", fields: [customerId], references: [id])
  professional   User                @relation("GigReviewProfessional", fields: [professionalId], references: [id])

  @@index([professionalId, status])
}

model ServiceDispute {
  id          String                @id @default(cuid())
  bookingId   String
  openedById  String
  reason      String
  details     String?
  status      ServiceDisputeStatus  @default(OPEN)
  resolution  String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  booking     ServiceBooking        @relation(fields: [bookingId], references: [id])
  openedBy    User                  @relation("GigDisputeOpener", fields: [openedById], references: [id])

  @@index([bookingId])
  @@index([status])
}

/// Curated landing-page cards. These describe a service offering, never a fake provider.
model ServiceSpotlight {
  id            String          @id @default(cuid())
  categoryId    String
  title         String
  blurb         String?
  imageUrl      String
  locationLabel String?
  href          String?
  sortOrder     Int             @default(0)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  category      ServiceCategory @relation(fields: [categoryId], references: [id])

  @@index([isActive, sortOrder])
}

/// Singleton admin-managed NaijaGigs landing copy.
model GigSiteConfig {
  id            String   @id @default("default")
  heroTitle     String   @default("Skilled hands. Brilliant minds. One Africa.")
  heroSubtitle  String   @default("Find trusted professionals for every project — at home, at work, and online.")
  heroImageUrl  String?
  announcement  String?
  updatedBy     String?
  updatedAt     DateTime @updatedAt
}

// ===========================================================================
// NaijaStream — music & audio streaming vertical
// Reuses shared users, wallets and the double-entry ledger. Money appears only
// as rows in the existing WalletTransaction/LedgerEntry tables; NaijaStream
// tables hold catalog, social graph, play telemetry and royalty accruals.
// ===========================================================================

enum StreamTrackStatus {
  DRAFT
  PROCESSING
  PUBLISHED
  UNPUBLISHED
  TAKEDOWN
}

enum StreamReleaseType {
  SINGLE
  EP
  ALBUM
  PODCAST
  MIX
  LIVE
}

enum StreamRoyaltyStatus {
  ACCRUED
  STATEMENTED
  PAID
  VOID
}

model StreamArtist {
  id            String   @id @default(cuid())
  userId        String   @unique
  name          String
  slug          String   @unique
  bio           String?
  avatarUrl     String?
  coverUrl      String?
  verified      Boolean  @default(false)
  verifiedAt    DateTime?
  countryCode   String   @default("NG")
  city          String?
  genres        String[] @default([])
  isSample      Boolean  @default(false)
  commissionBps Int      @default(1200)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  releases      StreamRelease[]
  tracks        StreamTrack[]
  playlists     StreamPlaylist[]
  follows       StreamFollow[]
  shows         StreamShow[]
  videos        StreamVideo[]

  @@index([verified, isSample])
}

model StreamRelease {
  id          String            @id @default(cuid())
  artistId    String
  title       String
  slug        String            @unique
  type        StreamReleaseType @default(SINGLE)
  artworkUrl  String?
  description String?
  releasedAt  DateTime?
  isPublished Boolean           @default(false)
  isSample    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  artist      StreamArtist      @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks      StreamTrack[]

  @@index([artistId, isPublished])
}

model StreamTrack {
  id           String            @id @default(cuid())
  artistId     String
  releaseId    String?
  title        String
  slug         String            @unique
  durationSec  Int
  audioUrl     String?
  artworkUrl   String?
  genre        String?
  language     String?
  explicit     Boolean           @default(false)
  status       StreamTrackStatus @default(DRAFT)
  rightsDeclared Boolean         @default(false)
  publishedAt  DateTime?
  playCount    BigInt            @default(0)
  isSample     Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  artist       StreamArtist      @relation(fields: [artistId], references: [id], onDelete: Cascade)
  release      StreamRelease?    @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  plays        StreamPlay[]
  playlistItems StreamPlaylistItem[]
  likes        StreamLike[]
  royalties    StreamRoyaltyAccrual[]

  @@index([status, publishedAt])
  @@index([artistId, status])
  @@index([genre])
}

model StreamPlaylist {
  id          String   @id @default(cuid())
  ownerId     String?          // null = editorial playlist
  artistId    String?          // artist-curated playlist
  title       String
  slug        String   @unique
  description String?
  coverUrl    String?
  isPublic    Boolean  @default(true)
  isEditorial Boolean  @default(false)
  isSample    Boolean  @default(false)
  createdAt   DateTime @default(now())
  owner       User?          @relation("StreamPlaylistOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  artist      StreamArtist?  @relation(fields: [artistId], references: [id], onDelete: SetNull)
  items       StreamPlaylistItem[]
  follows     StreamPlaylistFollow[]

  @@index([isEditorial, isPublic])
}

model StreamPlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  position   Int
  addedAt    DateTime @default(now())
  playlist   StreamPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      StreamTrack    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId, position])
}

model StreamPlaylistFollow {
  id         String   @id @default(cuid())
  playlistId String
  userId     String
  createdAt  DateTime @default(now())
  playlist   StreamPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user       User           @relation("StreamPlaylistFollows", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([playlistId, userId])
}

model StreamFollow {
  id        String   @id @default(cuid())
  artistId  String
  userId    String
  createdAt DateTime @default(now())
  artist    StreamArtist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  user      User         @relation("StreamFollows", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([artistId, userId])
}

model StreamLike {
  id        String   @id @default(cuid())
  trackId   String
  userId    String
  createdAt DateTime @default(now())
  user      User         @relation("StreamLikes", fields: [userId], references: [id], onDelete: Cascade)
  track     StreamTrack  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, userId])
}

/// One row per play. Deduplicated per (track, user, 30s bucket) so a client
/// replay or duplicate report cannot inflate counts or royalties.
model StreamPlay {
  id         String   @id @default(cuid())
  trackId    String
  userId     String?
  bucket     String   // e.g. "2026-11-08T10:30" — unique per track/user/bucket
  secondsPlayed Int   @default(0)
  eligible   Boolean  @default(false)
  createdAt  DateTime @default(now())
  track      StreamTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, userId, bucket])
  @@index([trackId, createdAt])
}

/// Royalty accrual per track per period. Pending accruals are NOT cash; only
/// settled transfers to the artist wallet move money on the shared ledger.
model StreamRoyaltyAccrual {
  id           String              @id @default(cuid())
  trackId      String
  artistId     String
  period       String              // YYYY-MM
  eligiblePlays BigInt             @default(0)
  rateKoboPerPlay BigInt           @default(0)
  grossKobo    BigInt              @default(0)
  platformKobo BigInt              @default(0)
  artistKobo   BigInt              @default(0)
  currency     String              @default("NGN")
  status       StreamRoyaltyStatus @default(ACCRUED)
  ledgerReference String?          // WalletTransaction.reference once settled
  calculatedAt DateTime            @default(now())
  track        StreamTrack         @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, period])
  @@index([artistId, period])
}

/// Admin-configurable royalty pool rate per period (never hard-coded per play).
model StreamRevenuePool {
  id            String   @id @default(cuid())
  period        String   @unique
  poolKobo      BigInt
  eligiblePlays BigInt   @default(0)
  rateKoboPerPlay BigInt @default(0)
  currency      String   @default("NGN")
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())
}

// --- NaijaStream podcasts & video -------------------------------------------

model StreamShow {
  id          String   @id @default(cuid())
  artistId    String
  title       String
  slug        String   @unique
  description String?
  coverUrl    String?
  category    String   @default("Culture")
  language    String   @default("English")
  isSample    Boolean  @default(false)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  artist      StreamArtist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  episodes    StreamEpisode[]

  @@index([published, category])
}

model StreamEpisode {
  id          String   @id @default(cuid())
  showId      String
  title       String
  slug        String   @unique
  description String?
  audioUrl    String?
  durationSec Int
  season      Int      @default(1)
  episodeNo   Int
  publishedAt DateTime?
  status      StreamTrackStatus @default(DRAFT)
  isSample    Boolean  @default(false)
  show        StreamShow @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@unique([showId, season, episodeNo])
  @@index([status, publishedAt])
}

model StreamVideo {
  id          String   @id @default(cuid())
  artistId    String?
  title       String
  slug        String   @unique
  description String?
  videoUrl    String
  posterUrl   String?
  durationSec Int
  kind        String   @default("MUSIC_VIDEO")
  status      StreamTrackStatus @default(DRAFT)
  isSample    Boolean  @default(false)
  publishedAt DateTime?
  views       BigInt   @default(0)
  createdAt   DateTime @default(now())
  artist      StreamArtist? @relation(fields: [artistId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
}

model StreamLiveEvent {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  artworkUrl  String?
  startsAt    DateTime
  endsAt      DateTime?
  status      String   @default("UPCOMING") // UPCOMING | LIVE | ENDED | CANCELLED
  streamUrl   String?
  startedAt   DateTime?
  endedAt     DateTime?
  organizerId String?
  isFree      Boolean  @default(true)
  priceKobo   BigInt?
  isSample    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([status, startsAt])
}

/// Private uploaded media. Files live outside public/ and are streamed only
/// after an ownership/entitlement check (lib/services/stream/storage.ts).
enum StreamMediaStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  CANCELLED
}

model StreamMediaAsset {
  id            String            @id @default(cuid())
  ownerId       String
  kind          String            // AUDIO | VIDEO | IMAGE
  storageKey    String            @unique
  mimeType      String
  sizeBytes     Int
  originalName  String?
  durationSec   Int?
  width         Int?
  height        Int?
  bitrate       Int?
  status        StreamMediaStatus @default(PENDING)
  error         String?
  processedKey  String?           // optional normalised output
  attempts      Int               @default(0)
  purpose       String            @default("TRACK") // TRACK | EPISODE | VIDEO | ARTWORK
  publicVisible Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  owner         User              @relation("StreamMediaOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@index([kind, status])
}

// --- NaijaStream Premium subscriptions (shared NaijaPay ledger) -------------

enum StreamSubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

model StreamPlan {
  id           String   @id @default(cuid())
  code         String   @unique          // FREE | BASIC | STANDARD | PREMIUM
  name         String
  description  String?
  priceKobo    BigInt   @default(0)
  interval     String   @default("MONTH") // MONTH | YEAR
  currency     String   @default("NGN")
  features     String[] @default([])
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  subscriptions StreamSubscription[]
}

model StreamSubscription {
  id             String                    @id @default(cuid())
  userId         String
  planId         String
  status         StreamSubscriptionStatus @default(ACTIVE)
  startsAt       DateTime                  @default(now())
  currentPeriodEnd DateTime
  cancelAtPeriodEnd Boolean                @default(false)
  cancelledAt    DateTime?
  provider       String                    @default("wallet") // wallet | test | paystack | flutterwave
  ledgerReference String?                  @unique
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  user           User                      @relation("StreamSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  plan           StreamPlan                @relation(fields: [planId], references: [id])

  @@index([userId, status])
}

model StreamBillingRecord {
  id             String   @id @default(cuid())
  subscriptionId String
  userId         String
  amountKobo     BigInt
  currency       String   @default("NGN")
  ledgerReference String
  periodStart    DateTime
  periodEnd      DateTime
  status         String   @default("PAID")
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

/// Admin-managed homepage carousel slides (Control Center editable).
model StreamHeroSlide {
  id           String   @id @default(cuid())
  eyebrow      String   @default("Featured")
  headline     String
  accent       String   @default("")
  body         String   @default("")
  imageUrl     String
  mobileImageUrl String?
  primaryLabel String
  primaryHref  String
  secondaryLabel String
  secondaryHref  String
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  updatedBy    String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@index([isActive, sortOrder])
}

/// Editorial city catalogue powering Explore Africa. Artwork is approved by
/// operators; an empty imageUrl means "no approved city image yet" and the card
/// must say so rather than borrowing another city's picture.
model StreamCity {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  countryCode     String
  countryName     String
  region          String
  genres          String[]  @default([])
  imageUrl        String?
  imageCredit     String?
  imageApprovedAt DateTime?
  featured        Boolean   @default(false)
  sortOrder       Int       @default(0)

  @@index([region, sortOrder])
  @@index([featured])
}

/// Podcast category catalogue: drives the Featured Podcasts rail so operators
/// can curate it without hardcoding copy in the UI.
model StreamPodcastCategory {
  id        String @id @default(cuid())
  slug      String @unique
  label     String
  sortOrder Int    @default(0)
}

// ---------------------------------------------------------------------------
// NaijaSend — logistics marketplace
//
// NaijaSend connects shipping demand with INDEPENDENT providers. It does not
// own trucks, vans, aircraft, ships, rail or warehouses, and the schema never
// records NaijaSend as the operator of a transport mode. NaijaDrive drivers and
// vehicles may enrol as providers through `sourcePlatform = "naijadrive"`;
// airlines, shipping lines, rail operators, forwarders and trucking companies
// are separate provider organisations.
// ---------------------------------------------------------------------------

/// One shipment request from a customer, business or another NaijaDeals vertical.
model LogisticsShipment {
  id              String   @id @default(cuid())
  reference       String   @unique
  customerId      String
  /// individual | business | enterprise | farm | institution
  customerKind    String   @default("individual")
  /// parcel | goods | freight | bulk
  cargoClass      String   @default("parcel")
  /// Produce category slug when cargoClass is bulk/farm.
  cargoCategory   String?
  description     String
  weightKg        Int      @default(1)
  quantity        Int      @default(1)
  dimensions      String?
  declaredValueKobo BigInt @default(0)
  handling        String?
  originLabel     String
  originCountry   String   @default("Nigeria")
  destinationLabel String
  destinationCountry String @default("Nigeria")
  senderName      String
  senderPhone     String
  recipientName   String
  recipientPhone  String
  pickupDate      DateTime?
  /// "request_quote" (default) | "instant" (only where a verified rate exists)
  bookingModel    String   @default("request_quote")
  /// Preferred first-leg mode: motorcycle | car | van | truck | air | sea | rail | warehouse
  preferredMode   String?
  /// open | quoting | booked | in_transit | delivered | completed | cancelled | expired
  status          String   @default("open")
  /// Set when this shipment fulfils another vertical (eats | fresh | drive | shop).
  sourceVertical  String?
  sourceReference String?
  /// Immutable origin of the shipment: naijasend | naijashop | naijafresh | naijaeats.
  /// A shipment created from an order keeps that vertical for life; only an
  /// audited admin correction may change it.
  originVertical  String   @default("naijasend")
  /// Customer-facing tracking number (distinct from the internal reference).
  trackingNumber  String?  @unique
  /// Optimistic concurrency guard: every state transition must match this.
  version         Int      @default(0)
  /// Transport state machine position (see lib/services/send/state-machine.ts).
  transportState  String   @default("awaiting_quote")
  /// Hash of the pickup PIN the sender holds; the plain PIN is never stored here.
  assignedPickupPinHash String?
  /// Set when the current transporter assignment was made.
  assignedAt      DateTime?
  pickupVerifiedAt   DateTime?
  deliveryVerifiedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  customer        User     @relation("LogisticsShipments", fields: [customerId], references: [id])
  packages        ShipmentPackage[]
  quotes          ShipmentQuote[]
  legs            ShipmentLeg[]
  events          ShipmentEvent[]
  assignment      ShipmentAssignment?
  pickups         ShipmentPickup[]

  @@index([customerId, status])
  @@index([status, createdAt])
  @@index([sourceVertical, sourceReference])
  @@index([originVertical])
  /// One logistics shipment per originating order: the database, not the app,
  /// prevents a second shipment being created for the same order.
  @@unique([originVertical, sourceReference])
}

model ShipmentPackage {
  id          String   @id @default(cuid())
  shipmentId  String
  description String
  weightKg    Int
  quantity    Int      @default(1)
  dimensions  String?
  shipment    LogisticsShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

/// An independent logistics provider organisation or individual.
model LogisticsProvider {
  id            String   @id @default(cuid())
  ownerId       String
  name          String
  /// courier | car | van | truck | fleet | air | sea | rail | warehouse | forwarder | logistics
  providerType  String
  /// naijasend (registered here) | naijadrive (enrolled from NaijaDrive)
  sourcePlatform String  @default("naijasend")
  country       String   @default("Nigeria")
  operatingCities String[] @default([])
  contactPhone  String
  /// Legal registration / licence details supplied by the provider.
  licenceRef    String?
  insuranceRef  String?
  /// pending | verified | rejected | suspended
  status        String   @default("pending")
  verifiedAt    DateTime?
  /// Capacity envelope advertised by the provider (not a NaijaSend guarantee).
  capacityKg    Int?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  owner         User     @relation("LogisticsProviderOwner", fields: [ownerId], references: [id])
  vehicles      ProviderVehicle[]
  quotes        ShipmentQuote[]

  @@index([providerType, status])
  @@index([country, status])
  @@index([sourcePlatform])
}

/// A vehicle or transport asset the provider operates. NaijaDrive vehicles are
/// linked here by `driverProfileId` rather than copied.
model ProviderVehicle {
  id              String   @id @default(cuid())
  providerId      String
  /// truck types: box | flatbed | container | refrigerated | tipper | tanker | heavy_haul
  vehicleType     String
  make            String?
  model           String?
  plate           String?
  capacityKg      Int      @default(0)
  /// Enrolled NaijaDrive driver, when the vehicle came from NaijaDrive.
  driverProfileId String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  provider        LogisticsProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, active])
  @@unique([providerId, plate])
}

/// A provider's quotation against a shipment. Only the provider sets the price.
model ShipmentQuote {
  id           String   @id @default(cuid())
  shipmentId   String
  providerId   String
  amountKobo   BigInt
  currency     String   @default("NGN")
  transitDays  Int      @default(1)
  /// Transport modes this quote covers, in order (multimodal when > 1).
  modes        String[] @default([])
  message      String?
  /// offered | accepted | declined | expired | withdrawn
  status       String   @default("offered")
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  shipment     LogisticsShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  provider     LogisticsProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, providerId])
  @@index([shipmentId, status])
  @@index([providerId, status])
}

/// One leg of a shipment. A shipment is delivered only when every leg is.
model ShipmentLeg {
  id            String   @id @default(cuid())
  shipmentId    String
  sequence      Int
  /// motorcycle | car | van | truck | air | sea | rail | warehouse
  mode          String
  providerId    String?
  fromLabel     String
  toLabel       String
  /// pending | assigned | picked_up | in_transit | arrived | failed
  status        String   @default("pending")
  carrierRef    String?
  /// Customer-visible pickup and delivery codes for the first and last leg.
  pickupPin     String?
  deliveryPin   String?
  startedAt     DateTime?
  completedAt   DateTime?
  shipment      LogisticsShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, sequence])
  @@index([shipmentId, status])
}

model ShipmentEvent {
  id         String   @id @default(cuid())
  shipmentId String
  status     String
  /// Timeline label shown to the customer.
  label      String
  note       String?
  actorId    String?
  /// Simulated external carrier milestone (never presented as live tracking).
  simulated  Boolean  @default(false)
  /// Makes a repeated transition a no-op instead of a duplicate event.
  idempotencyKey String?
  createdAt  DateTime @default(now())
  shipment   LogisticsShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, createdAt])
  @@unique([shipmentId, idempotencyKey])
}

/// Proof supplied by the provider at handover.
model ShipmentProof {
  id         String   @id @default(cuid())
  shipmentId String
  legId      String?
  /// pickup | delivery | incident
  kind       String
  note       String?
  actorId    String?
  createdAt  DateTime @default(now())

  @@index([shipmentId])
}

/// The authoritative link between a shipment and the transporter executing it.
/// A shipment is "NaijaSend-validated" only when this row exists, the provider is
/// verified, and the customer booked that provider's quote. A driver pressing a
/// button cannot create this row.
model ShipmentAssignment {
  id             String   @id @default(cuid())
  shipmentId     String   @unique
  providerId     String
  quoteId        String
  /// Vehicle the provider committed for this shipment.
  vehicleId      String?
  /// Hash of the delivery PIN handed to the customer at booking; the plain PIN
  /// is never stored on the assignment.
  deliveryPinHash String
  assignedAt     DateTime @default(now())
  revokedAt      DateTime?
  revokedReason  String?
  shipment       LogisticsShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

/// A verified physical handover. Only a customer-verified pickup PIN or a sender
/// confirmation creates one, and the unique shipmentId means a shipment can never
/// be marked picked up twice.
model ShipmentPickup {
  id              String   @id @default(cuid())
  shipmentId      String   @unique
  legId           String?
  actorId         String
  /// pin | sender | admin
  method          String
  pickupPinUsed   Boolean  @default(true)
  providerId      String
  verifiedAt      DateTime @default(now())
  note            String?
  shipment        LogisticsShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

// ---------------------------------------------------------------------------
// NaijaStay — accommodation, short lets, rentals and land
//
// A host owns properties; a property has one or more units (a whole villa is one
// unit). Availability is a date range on a unit, and an exclusion constraint in
// the migration makes overlapping live reservations impossible at the database
// level. Prices are always computed on the server in integer kobo.
// ---------------------------------------------------------------------------

model StayHost {
  id           String   @id @default(cuid())
  ownerId      String   @unique
  displayName  String
  bio          String?
  phone        String?
  country      String   @default("Nigeria")
  /// pending | verified | rejected | suspended
  status       String   @default("pending")
  verifiedAt   DateTime?
  /// Identity/document reference the host supplied; never invented by the platform.
  documentRef  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  owner        User     @relation("StayHostOwner", fields: [ownerId], references: [id])
  properties   StayProperty[]

  @@index([status])
}

model StayProperty {
  id            String   @id @default(cuid())
  hostId        String
  slug          String   @unique
  title         String
  /// hotels | serviced-apartments | short-term-rentals | long-term-rentals |
  /// houses-for-sale | land-and-plots | student-accommodation | corporate-stays |
  /// vacation-homes | event-conference-spaces
  category      String
  /// stay | rent | sale | land
  listingType   String   @default("stay")
  description   String
  city          String
  state         String?
  country       String   @default("Nigeria")
  addressLine   String?
  latitude      Float?
  longitude     Float?
  bedrooms      Int      @default(1)
  beds          Int      @default(1)
  bathrooms     Int      @default(1)
  maxGuests     Int      @default(2)
  /// Amenities the HOST supplied; the platform never adds unverified claims.
  amenities     String[] @default([])
  houseRules    String[] @default([])
  powerBackup   Boolean  @default(false)
  waterSupply   Boolean  @default(false)
  internet      Boolean  @default(false)
  parking       Boolean  @default(false)
  accessible    Boolean  @default(false)
  security24h   Boolean  @default(false)
  /// nightly price in kobo for the base unit (stays/rents)
  nightlyKobo   BigInt   @default(0)
  /// sale price in kobo for sale/land listings
  salePriceKobo BigInt?
  cleaningFeeKobo BigInt @default(0)
  serviceFeeBps Int      @default(500)
  minimumNights Int      @default(1)
  currency      String   @default("NGN")
  timeZone      String   @default("Africa/Lagos")
  /// draft | pending | published | rejected | suspended
  status        String   @default("draft")
  /// true for clearly-labelled demonstration listings only
  isDemo        Boolean  @default(false)
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  host          StayHost @relation(fields: [hostId], references: [id])
  images        StayImage[]
  units         StayUnit[]
  reservations  StayReservation[]
  reviews       StayReview[]

  @@index([category, status])
  @@index([city, status])
  @@index([listingType, status])
}

/// Ordered gallery images. Generated demo art is marked so it is never presented
/// as a photograph of a real bookable property.
model StayImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  alt        String
  sortOrder  Int      @default(0)
  kind       String   @default("photo") // photo | generated-demo
  property   StayProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
}

model StayUnit {
  id           String   @id @default(cuid())
  propertyId   String
  name         String
  maxGuests    Int      @default(2)
  nightlyKobo  BigInt   @default(0)
  quantity     Int      @default(1)
  property     StayProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservations StayReservation[]

  @@index([propertyId])
}

/// A host-blocked date range (maintenance, personal use).
model StayBlock {
  id         String   @id @default(cuid())
  unitId     String
  startDate  DateTime
  endDate    DateTime
  reason     String?
  createdAt  DateTime @default(now())

  @@index([unitId, startDate])
}

model StayReservation {
  id            String   @id @default(cuid())
  reference     String   @unique
  propertyId    String
  unitId        String
  guestId       String
  /// hold | awaiting_payment | confirmed | cancelled | completed | no_show | disputed
  status        String   @default("hold")
  paymentStatus String   @default("unpaid")
  checkIn       DateTime
  checkOut      DateTime
  nights        Int
  guests        Int
  rooms         Int      @default(1)
  /// Server-computed snapshot of the accepted price and policy.
  currency      String   @default("NGN")
  nightlyKobo   BigInt
  subtotalKobo  BigInt
  cleaningKobo  BigInt   @default(0)
  serviceKobo   BigInt   @default(0)
  totalKobo     BigInt
  policySnapshot String
  guestName     String
  guestPhone    String
  holdExpiresAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// Version for optimistic transitions.
  version       Int      @default(0)
  property      StayProperty @relation(fields: [propertyId], references: [id])
  unit          StayUnit     @relation(fields: [unitId], references: [id])
  guest         User         @relation("StayGuest", fields: [guestId], references: [id])
  events        StayReservationEvent[]

  @@index([propertyId, status])
  @@index([guestId, status])
  @@index([unitId, checkIn, checkOut])
}

model StayReservationEvent {
  id            String   @id @default(cuid())
  reservationId String
  status        String
  note          String?
  actorId       String?
  createdAt     DateTime @default(now())
  reservation   StayReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, createdAt])
}

model StayReview {
  id            String   @id @default(cuid())
  propertyId    String
  reservationId String   @unique
  guestId       String
  rating        Int
  comment       String?
  status        String   @default("published")
  createdAt     DateTime @default(now())
  property      StayProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
}

/// Host ↔ guest messages, scoped to one property or reservation.
model StayMessage {
  id            String   @id @default(cuid())
  propertyId    String?
  reservationId String?
  senderId      String
  body          String
  createdAt     DateTime @default(now())

  @@index([propertyId, createdAt])
  @@index([reservationId, createdAt])
}

// ---------------------------------------------------------------------------
// NaijaDeals platform — shared mobile/PWA foundation
//
// A registered device belongs to exactly one signed-in user and carries the
// capabilities it actually reported. Location fixes are captured only while a
// tracked work session is active, are de-duplicated per device, and are readable
// only by the owning user and authorised operations staff.
// ---------------------------------------------------------------------------

model DeviceRegistration {
  id           String   @id @default(cuid())
  userId       String
  /// web | android | ios
  platform     String
  /// FCM/push token when a push provider is configured; null otherwise.
  pushToken    String?
  appVersion   String?
  /// JSON capability report captured at registration (location, wakeLock, push…).
  capabilities String?
  lastSeenAt   DateTime @default(now())
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  user         User     @relation("UserDevices", fields: [userId], references: [id], onDelete: Cascade)
  pings        LocationPing[]

  @@index([userId, platform])
}

/// One recorded position. `clientId` makes uploads idempotent, so a retried
/// queue entry can never create a duplicate row.
model LocationPing {
  id          String   @id @default(cuid())
  deviceId    String
  userId      String
  /// Session this fix belongs to: "drive:<rideId>", "send:<shipmentId>".
  sessionRef  String
  latitude    Float
  longitude   Float
  accuracyM   Float?
  speedMps    Float?
  headingDeg  Float?
  /// Device-side capture time; ordering always uses this, never arrival time.
  capturedAt  DateTime
  /// Client-generated unique id for idempotent upload.
  clientId    String
  source      String   @default("browser") // browser | native
  createdAt   DateTime @default(now())
  device      DeviceRegistration @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, clientId])
  @@index([sessionRef, capturedAt])
  @@index([userId, capturedAt])
}

// ---------------------------------------------------------------------------
// Homepage experience system
//
// Four dashboard designs share one platform. A visitor is assigned one variant
// by a stable first-party identifier and keeps it; a manual choice always wins.
// Admins control which variants are live, their allocation and the hero slides.
// ---------------------------------------------------------------------------

model HomeVariant {
  id          String   @id @default(cuid())
  /// original | africa-super-app | mobility | commerce
  key         String   @unique
  name        String
  description String
  enabled     Boolean  @default(true)
  /// Share of new visitors, in whole percent. Enabled variants must total 100.
  allocation  Int      @default(25)
  sortOrder   Int      @default(0)
  /// Bumped on every admin save so concurrent edits cannot silently overwrite.
  revision    Int      @default(1)
  slides      HomeHeroSlide[]
  updatedAt   DateTime @updatedAt
}

model HomeHeroSlide {
  id          String   @id @default(cuid())
  variantKey  String
  /// Identifies the slide in code so imagery and copy can be edited independently.
  slug        String
  headline    String
  body        String
  ctaLabel    String
  ctaHref     String
  secondaryLabel String?
  secondaryHref  String?
  imageId     String?
  /// Alt text is required; a slide without it cannot be published.
  alt         String
  sortOrder   Int      @default(0)
  enabled     Boolean  @default(true)
  /// Optional campaign window (ISO dates, inclusive).
  startsAt    DateTime?
  endsAt      DateTime?
  variant     HomeVariant @relation(fields: [variantKey], references: [key], onDelete: Cascade)

  @@unique([variantKey, slug])
  @@index([variantKey, enabled, sortOrder])
}

/// Pins a visitor to a variant so refreshes are stable across restarts.
model HomeAssignment {
  id         String   @id @default(cuid())
  /// Anonymous first-party id from an httpOnly cookie.
  visitorId  String   @unique
  variantKey String
  /// true when the visitor chose this design themselves.
  manual     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([variantKey])
}

/// Aggregate counters only: no personal data, no per-visitor profiles.
model HomeMetric {
  id        String   @id @default(cuid())
  variantKey String
  /// impression | hero_impression | hero_click | card_click | search | cta_click
  kind      String
  /// Empty string when the event is not slide-scoped: NULL would defeat the
  /// unique index, since Postgres treats NULLs as distinct.
  slideSlug String   @default("")
  day       DateTime @default(now())
  count     Int      @default(0)

  @@unique([variantKey, kind, slideSlug, day])
  @@index([variantKey, day])
}

/// A standalone wallet top-up, separate from order payments.
///
/// `Payment` is order-scoped (`orderId` is required), so crediting a wallet
/// without an order needs its own record. This is additive: nothing existing
/// changes, and the credit itself still posts through the shared double-entry
/// ledger via `postBalancedTransaction`.
model WalletTopUp {
  id                String        @id @default(cuid())
  walletId          String
  provider          String
  /// Provider's own reference. Unique so a repeated webhook cannot credit twice.
  providerReference String        @unique
  /// Caller-supplied key. Unique so a resubmitted form cannot create two top-ups.
  idempotencyKey    String        @unique
  status            PaymentStatus @default(PENDING)
  amountKobo        BigInt
  currency          String        @default("NGN")
  /// Set once the wallet has been credited, exactly once.
  creditedAt        DateTime?
  failureReason     String?
  /// Provider payload retained for dispute and reconciliation evidence.
  raw               Json?
  verifiedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  wallet            Wallet        @relation(fields: [walletId], references: [id])

  @@index([walletId, status])
  @@index([status, createdAt])
}

/// A milestone within a customer-to-customer escrow agreement.
///
/// The existing `EscrowHold` covers marketplace orders, where the buyer pays a
/// vendor once. Milestone escrow is different: two people agree a scope split
/// into stages, and each stage is funded, delivered and released separately.
/// Additive — no existing escrow table changes, and every release still posts
/// through the shared double-entry ledger.
enum MilestoneStatus {
  draft
  awaiting_funding
  funded
  submitted
  accepted
  released
  refunded
  disputed
  cancelled
}

model EscrowMilestone {
  id                String          @id @default(cuid())
  /// Human-facing reference shared by both parties and used in receipts.
  reference         String          @unique
  payerUserId       String
  payeeUserId       String
  title             String
  description       String?
  amountKobo        BigInt
  currency          String          @default("NGN")
  status            MilestoneStatus @default(draft)
  /// Monotonic guard so two concurrent transitions cannot both succeed.
  version           Int             @default(0)
  fundedAt          DateTime?
  submittedAt       DateTime?
  acceptedAt        DateTime?
  releasedAt        DateTime?
  refundedAt        DateTime?
  /// Which transaction moved the money, for receipt and reconciliation.
  fundingTransactionId String?
  settlementTransactionId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([payerUserId, status])
  @@index([payeeUserId, status])
}

// ---------------------------------------------------------------------------
// Aura AI
//
// Conversations belong to one user and are only ever read back through a
// session-derived user id. Messages store the rendered content plus a
// structured attachments payload (tool results, cards, plan references), so a
// refresh reconstructs the conversation exactly as it appeared.
// ---------------------------------------------------------------------------

enum AuraRole {
  user
  assistant
  tool
}

enum AuraActionStatus {
  proposed
  awaiting_confirmation
  executing
  completed
  failed
  cancelled
  expired
}

model AuraConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New conversation")
  /// Archived conversations stay readable but leave the active list.
  archived  Boolean  @default(false)
  /// A short rolling summary used to bound the context sent to the model.
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  messages  AuraMessage[]
  actions   AuraAction[]

  @@index([userId, archived, updatedAt])
}

model AuraMessage {
  id             String          @id @default(cuid())
  conversationId String
  role           AuraRole
  content        String
  /// Tool results, recommendation cards and plan references rendered under the
  /// message. JSON so the UI can restore without re-running anything.
  attachments    Json?
  /// Names of tools the model called for this turn, for the status trail.
  toolNames      String[]        @default([])
  /// Saved items appear in the user's Saved view.
  saved          Boolean         @default(false)
  /// Token usage reported by the provider for this turn, when available.
  promptTokens   Int?
  completionTokens Int?
  createdAt      DateTime        @default(now())
  conversation   AuraConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([saved])
}

/// A consequential action Aura prepared and the user must confirm.
///
/// The row freezes the exact proposal (recipient/service, options, amount) so a
/// confirmation can be checked against what was shown. If anything material
/// changed between proposal and confirmation, execution is refused and a new
/// proposal is required.
model AuraAction {
  id             String           @id @default(cuid())
  conversationId String
  userId         String
  tool           String
  status         AuraActionStatus @default(proposed)
  /// Human-readable summary of exactly what will happen.
  summary        String
  /// Frozen tool input, hashed so the confirmed request must match it.
  input          Json
  inputHash      String
  /// Price/recipient snapshot shown on the review card.
  reviewSnapshot Json
  /// Set when executed; the authoritative service's reference.
  resultReference String?
  resultPayload  Json?
  failureReason  String?
  /// Caller-supplied key so a repeated confirm cannot execute twice.
  idempotencyKey String           @unique
  expiresAt      DateTime
  confirmedAt    DateTime?
  executedAt     DateTime?
  createdAt      DateTime         @default(now())
  conversation   AuraConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([conversationId])
}

/// A saved cross-vertical plan (for example a Saturday in Abuja).
model AuraPlan {
  id             String      @id @default(cuid())
  userId         String
  conversationId String?
  title          String
  city           String?
  status         String      @default("draft")
  /// Ordered components: stay, meal, ride, with their chosen records and status.
  components     Json
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId, updatedAt])
}

/// Personalisation and privacy choices. Every field defaults to off/empty:
/// Aura does not remember anything the user did not ask it to remember.
model AuraPreference {
  userId              String    @id
  personalised        Boolean   @default(false)
  useSavedPreferences Boolean   @default(false)
  /// Free-form preferences the user typed or approved, nothing inferred.
  savedPreferences    Json?
  /// City/area the user selected manually; device location is never stored.
  preferredCity       String?
  preferredArea       String?
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// Per-turn usage and failure record for the Control Center. Stores counts and
/// latency only — never message content.
model AuraUsage {
  id            String   @id @default(cuid())
  userId        String?
  conversationId String?
  provider      String
  model         String
  status        String
  promptTokens  Int      @default(0)
  completionTokens Int   @default(0)
  latencyMs     Int      @default(0)
  toolCalls     Int      @default(0)
  errorCode     String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Notifications (shared engine)
// ---------------------------------------------------------------------------

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  SUPPRESSED
}

enum NotificationCategory {
  ORDERS
  PAYMENTS
  DISPATCH
  BOOKINGS
  SHIPMENTS
  ACCOUNT
  MARKETING
  SYSTEM
}

/// Operator-editable override of the code-defined default templates. A row
/// exists only when someone changed the wording; the defaults live in
/// lib/notifications/templates.ts so a missing row is never an error.
model NotificationTemplate {
  id        String              @id @default(cuid())
  key       String
  channel   NotificationChannel
  locale    String              @default("en-NG")
  subject   String?
  body      String
  active    Boolean             @default(true)
  version   Int                 @default(1)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([key, channel, locale])
  @@index([key, active])
}

/// One row per message, whatever the channel. `dedupeKey` is unique so a
/// replayed webhook or a retried request cannot produce a second message.
model Notification {
  id                String               @id @default(cuid())
  userId            String?
  user              User?                @relation("UserNotifications", fields: [userId], references: [id], onDelete: SetNull)
  channel           NotificationChannel
  category          NotificationCategory @default(SYSTEM)
  templateKey       String
  eventType         String
  entityType        String?
  entityId          String?
  title             String
  body              String
  data              Json?
  status            NotificationStatus   @default(QUEUED)
  attempts          Int                  @default(0)
  maxAttempts       Int                  @default(4)
  lastError         String?
  provider          String?
  providerMessageId String?
  dedupeKey         String               @unique
  scheduledFor      DateTime             @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  attemptsLog       NotificationAttempt[]

  @@index([userId, status, createdAt])
  @@index([status, scheduledFor])
  @@index([entityType, entityId])
}

model NotificationAttempt {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  attempt        Int
  provider       String
  ok             Boolean
  retryable      Boolean      @default(false)
  error          String?
  at             DateTime     @default(now())

  @@index([notificationId, at])
}

/// Absence of a row means "enabled": a new category ships on by default and a
/// user opts out, which is safer than silently dropping a message because no
/// preference row was ever written.
model NotificationPreference {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation("UserNotificationPreferences", fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  category  NotificationCategory
  enabled   Boolean              @default(true)
  updatedAt DateTime             @updatedAt

  @@unique([userId, channel, category])
}

// ---------------------------------------------------------------------------
// Search synchronisation outbox
// ---------------------------------------------------------------------------

enum SearchEntityType {
  PRODUCT
  RESTAURANT
  PRODUCE
  PROFESSIONAL
  SERVICE
  JOB
  PROPERTY
  TRANSPORT_PARTNER
}

enum SearchSyncOp {
  UPSERT
  DELETE
}

/// Durable outbox for index maintenance. One pending row per entity: repeated
/// changes collapse into the same row, and the worker deletes it only after the
/// index accepted the write. Postgres remains the source of truth.
model SearchSyncEvent {
  id          String          @id @default(cuid())
  dedupeKey   String          @unique
  entityType  SearchEntityType
  entityId    String
  op          SearchSyncOp    @default(UPSERT)
  attempts    Int             @default(0)
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([processedAt, createdAt])
}

enum NotificationIntentStatus {
  PENDING
  CLAIMED
  PROCESSED
  DEAD
}

/// Transactional outbox for notifications. The intent is written in the same
/// transaction as the business change, so a rollback removes both. The worker
/// delivers it afterwards, which keeps provider latency out of the transaction.
model NotificationIntent {
  id              String                   @id @default(cuid())
  dedupeKey       String                   @unique
  eventType       String
  entityType      String
  entityId        String
  recipientUserId String
  payload         Json
  payloadVersion  Int                      @default(1)
  status          NotificationIntentStatus @default(PENDING)
  attempts        Int                      @default(0)
  maxAttempts     Int                      @default(5)
  nextAttemptAt   DateTime                 @default(now())
  leaseOwner      String?
  leaseToken      String?
  leaseExpiresAt  DateTime?
  processedAt     DateTime?
  lastError       String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// NaijaDeals Affiliate (design committed 2026-11-10; owner waived Aura gate)
// ---------------------------------------------------------------------------

enum AffiliateStatus {
  APPLIED
  APPROVED
  SUSPENDED
  REJECTED
}

enum CampaignFunding {
  PLATFORM
  MERCHANT
}

enum AffiliateCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum ConversionState {
  TRACKED
  VALIDATING
  APPROVED
  PAYABLE
  PAYING
  PAID
  REJECTED
  REVERSED
  DISPUTED
}

enum PayoutState {
  REQUESTED
  APPROVED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

model AffiliateProfile {
  id              String            @id @default(cuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          AffiliateStatus   @default(APPLIED)
  displayName     String?
  channels        String[]          @default([])
  audienceCity    String?
  termsVersion    String
  termsAcceptedAt DateTime?
  payoutBank      String?
  payoutAccountName String?
  payoutAccountNumber String?
  riskNote        String?
  approvedAt      DateTime?
  suspendedReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  links           AffiliateLink[]
  conversions     AffiliateConversion[]
  payouts         AffiliatePayout[]

  @@index([status, createdAt])
}

model AffiliateCampaign {
  id                String                 @id @default(cuid())
  slug              String                 @unique
  name              String
  vertical          String                 @default("shop")
  status            AffiliateCampaignStatus @default(DRAFT)
  funding           CampaignFunding        @default(PLATFORM)
  /// Percentage in basis points, applied to the qualifying basis.
  commissionBps     Int                    @default(0)
  /// Fixed alternative in kobo; when set, takes precedence over commissionBps.
  commissionFlatKobo BigInt?
  budgetKobo        BigInt                 @default(0)
  spentKobo         BigInt                 @default(0)
  attributionDays   Int                    @default(30)
  /// Which amount is commissioned: SUBTOTAL (excludes delivery) or TOTAL.
  commissionBasis   String                 @default("SUBTOTAL")
  ruleVersion       Int                    @default(1)
  effectiveFrom     DateTime               @default(now())
  effectiveTo       DateTime?
  termsUrl          String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  links             AffiliateLink[]
  conversions       AffiliateConversion[]

  @@index([status, vertical])
}

model AffiliateLink {
  id          String             @id @default(cuid())
  affiliateId String
  affiliate   AffiliateProfile  @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  campaignId  String
  campaign    AffiliateCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  code        String             @unique
  /// Allowlisted destination path on this platform; never an external URL.
  destination String
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())

  touches     AttributionTouch[]
  conversions AffiliateConversion[]

  @@index([affiliateId, createdAt])
}

model AttributionTouch {
  id         String        @id @default(cuid())
  linkId     String
  link       AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  /// Hashed visitor key; no raw IP or device fingerprint is stored.
  visitorKey String
  userId     String?
  landedAt   DateTime      @default(now())
  expiresAt  DateTime
  consent    Boolean       @default(false)

  @@index([visitorKey, expiresAt])
}

model AffiliateConversion {
  id              String          @id @default(cuid())
  /// Unique: one qualifying event can never produce two commissions.
  dedupeKey       String          @unique
  affiliateId     String
  affiliate       AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  campaignId      String
  campaign        AffiliateCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  linkId          String?
  link            AffiliateLink?   @relation(fields: [linkId], references: [id], onDelete: SetNull)
  /// The order or booking that qualified, by type and id.
  entityType      String
  entityId        String
  /// Frozen at capture so a later rule edit cannot change an earned liability.
  ruleVersion     Int
  /// SUBTOTAL or TOTAL as it was when the conversion was created. Basis type is
  /// not derivable from basisKobo, and the campaign field is editable, so reading
  /// it later would let an edit rewrite history.
  basisType       String?
  /// Delivery amount included in basisKobo, when the basis was TOTAL.
  includedDeliveryKobo BigInt?
  commissionBps   Int
  basisKobo       BigInt
  amountKobo      BigInt
  state           ConversionState @default(TRACKED)
  /// Ledger reference once the liability or settlement is posted.
  ledgerReference String?
  reversibleUntil DateTime?
  reason          String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  /// Set when historical reversal evidence is insufficient to reconstruct a
  /// cumulative total. Financial mutation is blocked until reviewed.
  reconciliationRequired Boolean   @default(false)

  @@index([affiliateId, state, createdAt])
  @@index([entityType, entityId])
}

model AffiliatePayout {
  id            String      @id @default(cuid())
  affiliateId   String
  affiliate     AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  reference     String      @unique
  amountKobo    BigInt
  state         PayoutState @default(REQUESTED)
  ledgerReference String?
  requestedAt   DateTime    @default(now())
  decidedBy     String?
  decidedAt     DateTime?
  paidAt        DateTime?
  failureReason String?

  @@index([affiliateId, state, requestedAt])
}

enum RecoveryState {
  OUTSTANDING
  COLLECTED
  WRITTEN_OFF
}

/// Commission that was clawed back but could not be recovered because the
/// affiliate had already spent or withdrawn it. A shortfall is a receivable, not
/// a silent loss: it stays on the books until collected or explicitly written
/// off by an administrator.
model AffiliateRecovery {
  id              String        @id @default(cuid())
  conversionId    String
  affiliateId     String
  amountKobo      BigInt
  /// Cash recovered from the affiliate's wallet by a recovery sweep.
  collectedKobo   BigInt        @default(0)
  /// Debt extinguished by netting against a settlement payout; no cash moved.
  offsetKobo      BigInt        @default(0)
  state           RecoveryState @default(OUTSTANDING)
  ledgerReference String?
  note            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([affiliateId, state])
  @@index([state, createdAt])
  @@index([conversionId])
}

enum ReversalIntentState {
  PENDING
  PROCESSING
  DONE
  FAILED
}

/// Durable outbox for commission adjustments caused by confirmed refunds.
/// Written in the same transaction as the refund reaching COMPLETED, so a crash
/// cannot lose it and a rollback cannot leave one behind. Processed by the
/// worker, independently of the customer refund.
model AffiliateReversalIntent {
  id             String               @id @default(cuid())
  dedupeKey      String               @unique
  refundId       String
  orderId        String
  /// Gross refunded amount as reported by the provider.
  amountKobo     BigInt
  /// Portion of the refund that falls inside the conversion's frozen commission
  /// basis. Null on pre-policy intents, which must be reviewed rather than applied
  /// at the gross figure.
  eligibleKobo   BigInt?
  /// Identifies how eligibleKobo was derived, so a later change cannot be read as
  /// if it had always applied.
  allocationPolicy String?
  state          ReversalIntentState  @default(PENDING)
  attempts       Int                  @default(0)
  maxAttempts    Int                  @default(6)
  leaseToken     String?
  leaseExpiresAt DateTime?
  lastError      String?
  processedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([state, createdAt])
  @@index([orderId])
}

/// One committed reversal operation. Cumulative reversal is a SUM over these
/// rows, never a state flag: a partial reversal leaves the conversion PAID, so a
/// state-derived total silently resets to zero and permits over-reversal.
model AffiliateReversalOperation {
  id              String   @id @default(cuid())
  /// Stable identity per intent/conversion. Unique, so a replay cannot commit twice.
  opKey           String   @unique
  conversionId    String
  intentId        String?
  requestedKobo   BigInt
  recoveredKobo   BigInt   @default(0)
  debtKobo        BigInt   @default(0)
  ledgerReference String?
  actorId         String?
  createdAt       DateTime @default(now())

  @@index([conversionId])
}

/// The attribution frozen onto an order at checkout.
///
/// Scalar ids only: this is an immutable snapshot of the touch, link, campaign
/// and affiliate that qualified the order. It deliberately has no relations, so
/// later edits or deletions cannot rewrite what the order was attributed to.
model OrderAttribution {
  id          String   @id @default(cuid())
  orderId     String   @unique
  touchId     String
  linkId      String
  affiliateId String
  campaignId  String
  expiresAt   DateTime
  frozenAt    DateTime @default(now())

  @@index([affiliateId])
  @@index([campaignId])
}

// ---------------------------------------------------------------------------
// NaijaDeals Plus+ membership foundation.
//
// These models record configuration and membership state only. There is no
// purchase, billing, wallet or checkout path here: memberships are created by
// authorised staff, and money movement remains in the existing payments and
// ledger services.
//
// `userId` columns are intentionally scalar: adding a Prisma relation would
// require editing the existing User model, and the Plus+ foundation must not
// alter unrelated models. Ownership is enforced by the service layer.
// ---------------------------------------------------------------------------

/// Editorial decision states shared by awareness cards and genuine benefits.
enum PlusPublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PlusPlanStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum PlusBillingPeriod {
  MONTHLY
  ANNUAL
  NONE
}

enum PlusMembershipStatus {
  INVITED
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PlusEntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum PlusPromotionKind {
  HOUSE
  SPONSORED
}

enum PlusPromotionStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  ARCHIVED
}

/// A merchandising/awareness card shown on the public Plus+ landing page.
/// Rows are authored in the Control Center; the public page never hardcodes
/// promotional copy.
model PlusContentCard {
  id          String            @id @default(cuid())
  key         String            @unique
  title       String
  description String
  imageUrl    String
  imageAlt    String
  href        String
  serviceKey  String?
  sortOrder   Int               @default(0)
  status      PlusPublishStatus @default(DRAFT)
  language    String            @default("en")
  /// Empty means every configured marketplace country.
  countries   String[]          @default([])
  startsAt    DateTime?
  endsAt      DateTime?
  createdById String?
  updatedById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, sortOrder])
}

/// A purchasable (or free) Plus+ plan. `priceMinor` is in integer minor units
/// of `currency`. A positive price cannot be activated without an approved
/// effective term and `paidActivationApproved`.
model PlusPlan {
  id                     String            @id @default(cuid())
  code                   String            @unique
  name                   String
  description            String
  status                 PlusPlanStatus    @default(DRAFT)
  currency               String
  priceMinor             BigInt?
  billingPeriod          PlusBillingPeriod?
  paidActivationApproved Boolean           @default(false)
  sortOrder              Int               @default(0)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  countries   PlusPlanCountry[]
  terms       PlusPlanTerm[]
  memberships PlusMembership[]
  benefits    PlusBenefit[]

  @@index([status, sortOrder])
}

/// Country availability is opt-in per plan. A marketplace country being
/// enabled for commerce is not Plus+ eligibility.
model PlusPlanCountry {
  planId      String
  countryCode String
  enabled     Boolean @default(false)

  plan PlusPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, countryCode])
  @@index([countryCode, enabled])
}

/// A frozen, approvable version of commercial terms. Activation of a priced
/// plan requires at least one currently effective approved term.
model PlusPlanTerm {
  id                  String            @id @default(cuid())
  planId              String
  version             Int
  priceMinor          BigInt?
  currency            String
  billingPeriod       PlusBillingPeriod
  cancellationSummary String?
  termsUrl            String?
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  approvedAt          DateTime?
  approvedById        String?
  createdAt           DateTime          @default(now())

  plan PlusPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, version])
  @@index([planId, effectiveFrom])
}

/// Staff-created membership record. There is deliberately no customer purchase
/// route in this foundation.
model PlusMembership {
  id               String               @id @default(cuid())
  userId           String
  planId           String
  status           PlusMembershipStatus @default(INVITED)
  startedAt        DateTime?
  currentPeriodEnd DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  plan         PlusPlan          @relation(fields: [planId], references: [id])
  entitlements PlusEntitlement[]

  @@index([userId, status])
  @@index([planId, status])
}

/// A granted capability. Only an ACTIVE, unexpired entitlement owned by the
/// membership holder may be redeemed.
model PlusEntitlement {
  id           String                @id @default(cuid())
  membershipId String
  code         String
  status       PlusEntitlementStatus @default(ACTIVE)
  grantedAt    DateTime              @default(now())
  expiresAt    DateTime?
  metadata     Json?

  membership  PlusMembership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  redemptions PlusRedemption[]

  @@unique([membershipId, code])
}

/// One entitlement redemption. `idempotencyKey` is unique so an interrupted or
/// retried request cannot redeem twice.
model PlusRedemption {
  id             String   @id @default(cuid())
  entitlementId  String   @unique
  userId         String
  idempotencyKey String   @unique
  reference      String
  redeemedAt     DateTime @default(now())
  metadata       Json?

  entitlement PlusEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@index([userId, redeemedAt])
}

/// A genuine member benefit. Standard ecosystem services must not be recorded
/// here. Only PUBLISHED benefits attached to an available plan appear publicly.
model PlusBenefit {
  id          String            @id @default(cuid())
  key         String            @unique
  title       String
  description String
  planId      String?
  status      PlusPublishStatus @default(DRAFT)
  /// Empty means every configured marketplace country.
  countries   String[]          @default([])
  startsAt    DateTime?
  endsAt      DateTime?
  sortOrder   Int               @default(0)
  imageUrl    String?
  imageAlt    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  plan PlusPlan? @relation(fields: [planId], references: [id])

  @@index([status, sortOrder])
  @@index([planId, status])
}

/// House promotions and sponsored advertisements. `campaignRef` is an opaque
/// external reference only: no advertiser engine or bidding exists.
model PlusPromotion {
  id              String              @id @default(cuid())
  key             String              @unique
  kind            PlusPromotionKind
  title           String
  body            String
  imageUrl        String?
  imageAlt        String?
  href            String?
  status          PlusPromotionStatus @default(DRAFT)
  /// Empty means every configured marketplace country.
  countries       String[]            @default([])
  startsAt        DateTime?
  endsAt          DateTime?
  sponsorName     String?
  disclosureLabel String              @default("Sponsored")
  approvedAt      DateTime?
  approvedById    String?
  campaignRef     String?
  sortOrder       Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status, sortOrder])
  @@index([kind, status])
}

/// Editorial "Discover Africa" country record. This registry is deliberately
/// separate from the commerce COUNTRIES configuration: publishing a country
/// profile does not enable checkout, delivery, currency or a marketplace
/// operating entity in that country.
enum CountryEditorialStatus {
  NEEDS_REVIEW
  REVIEWED
}

enum CountryPublicationStatus {
  DRAFT
  PUBLISHED
}

model CountryProfile {
  code              String                    @id
  slug              String                    @unique
  name              String
  region            String
  localizedNames    Json?
  introduction      String
  editorialStatus   CountryEditorialStatus    @default(NEEDS_REVIEW)
  publicationStatus CountryPublicationStatus  @default(DRAFT)
  /// Featured on the Shop country rail. Featuring changes order, never coverage:
  /// every published country remains reachable from the directory.
  homeFeatured      Boolean                   @default(false)
  sortOrder         Int                       @default(0)
  publishedAt       DateTime?
  publishedBy       String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  themes CountryTheme[]

  @@index([publicationStatus, sortOrder])
  @@index([homeFeatured, sortOrder])
}

/// One editorial "Known for" association. It is information about the country,
/// not evidence that NaijaDeals supplies the product.
model CountryTheme {
  id                String                  @id @default(cuid())
  countryCode       String
  key               String
  label             String
  association       String
  imageUrl          String?
  imageAlt          String?
  imageKind         String?
  imageProvenance   String?
  sortOrder         Int                     @default(0)
  editorialStatus   CountryEditorialStatus  @default(NEEDS_REVIEW)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  country CountryProfile       @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  sources CountryThemeSource[]

  @@unique([countryCode, key])
  @@index([countryCode, sortOrder])
}

model CountryThemeSource {
  id        String   @id @default(cuid())
  themeId   String
  title     String
  publisher String?
  url       String
  accessedAt DateTime
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  theme CountryTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([themeId, url])
  @@index([themeId, sortOrder])
}
