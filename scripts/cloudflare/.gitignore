# Cloudflare tunnel credentials and local overrides must never enter Git.
# The README, config.yml (reference placeholders), configure/start/stop/status
# scripts, preflight/audit tools and approved-testers.sha256 are tracked. Real
# credentials, allowlist files and local overrides stay outside the repository.

config.local.yml
*.local.yml
credentials/
*.json
*.pem
*.key
*.log
.cert.pem
