{
  "name": "naijadeals-super-ecosystem",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "prebuild": "node scripts/clean-css-cache.mjs && node scripts/build-css.mjs",
    "build": "next build",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "qa:visual": "node scripts/visual-qa.mjs",
    "qa:ecosystem": "node scripts/ecosystem-smoke.mjs",
    "qa:drive-map": "node scripts/drive-map-qa.mjs",
    "qa:drive-places": "node scripts/drive-saved-places-qa.mjs",
    "qa:deadline": "node scripts/drive-deadline-qa.mjs",
    "qa:idle-sweep": "tsx scripts/drive-idle-sweep.ts",
    "qa:locale": "node scripts/locale-qa.mjs",
    "art:generate": "node scripts/generate-ecosystem-art.mjs && node scripts/generate-product-art.mjs",
    "prisma:seed": "prisma db seed",
    "test:marketplace": "tsx scripts/marketplace-tests.ts",
    "test:admin-security": "tsx scripts/admin-security-tests.ts",
    "test:drive": "tsx scripts/drive-tests.ts",
    "engine:verify": "tsx scripts/marketplace-tests.ts",
    "infra:up": "docker compose -f deploy/dev-infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f deploy/dev-infra/docker-compose.yml stop",
    "infra:verify": "tsx scripts/infra-verify.ts",
    "infra:worker": "tsx scripts/infra-worker.ts",
    "infra:mcp": "node scripts/mcp-verify.mjs playwright rea kie-ai"
