    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "bullmq": "^6.7.3",
    "clsx": "^2.1.1",
    "ioredis": "^6.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "^14.2.4",
    "pg": "^8.23.1",
    "postcss": "^8.4.39",
    "prisma": "^6.19.0",
    "prom-client": "^15.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3"
  },
  "devDependencies": {
