    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.20",
    "@types/pg": "^8.23.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "pixelmatch": "8.0.0",
    "playwright-core": "^1.60.0",
    "pngjs": "7.0.0",
    "tsx": "^4.22.4"
