# Database
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME"
DATABASE_POOL_MIN="1"
DATABASE_POOL_MAX="10"

# Auth / Session
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"
SESSION_COOKIE_NAME="naijadeals.session"

# Payments
PAYSTACK_SECRET_KEY="REPLACE_WITH_PAYSTACK_SECRET_KEY"
PAYSTACK_PUBLIC_KEY="REPLACE_WITH_PAYSTACK_PUBLIC_KEY"
FLUTTERWAVE_SECRET_KEY="REPLACE_WITH_FLUTTERWAVE_SECRET_KEY"
PAYMENT_WEBHOOK_SECRET="REPLACE_WITH_PAYMENT_WEBHOOK_SECRET"

# Escrow / Wallet
WALLET_LEDGER_API_URL="https://ledger.example.com"
WALLET_LEDGER_API_KEY="REPLACE_WITH_WALLET_LEDGER_API_KEY"
ESCROW_HOLD_ACCOUNT_ID="escrow-hold-account"
ESCROW_RELEASE_WEBHOOK_SECRET="REPLACE_WITH_ESCROW_WEBHOOK_SECRET"

# Email / SMS
RESEND_API_KEY="REPLACE_WITH_RESEND_API_KEY"
SENDGRID_API_KEY="REPLACE_WITH_SENDGRID_API_KEY"
TERMII_API_KEY="REPLACE_WITH_TERMII_API_KEY"
SMS_SENDER_ID="NaijaDeals"

# Maps / Location
GOOGLE_MAPS_API_KEY="REPLACE_WITH_GOOGLE_MAPS_API_KEY"
MAPBOX_ACCESS_TOKEN="REPLACE_WITH_MAPBOX_ACCESS_TOKEN"
LOCATION_WEBHOOK_SECRET="REPLACE_WITH_LOCATION_WEBHOOK_SECRET"

# AI Provider
OPENAI_API_KEY="REPLACE_WITH_AI_PROVIDER_API_KEY"
AI_PROVIDER="openai"
AURA_AI_MODEL="gpt-4.1-mini"

# Storage
S3_ENDPOINT="https://s3.amazonaws.com"
S3_BUCKET="naijadeals-demo"
S3_ACCESS_KEY_ID="REPLACE_WITH_S3_ACCESS_KEY_ID"
S3_SECRET_ACCESS_KEY="REPLACE_WITH_S3_SECRET_ACCESS_KEY"
S3_REGION="af-south-1"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="local"
