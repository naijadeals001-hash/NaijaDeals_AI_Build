# ---------------------------------------------------------------------------
# NaijaDeals environment configuration
#
# Copy to .env and fill in real values. Anything left blank or still holding a
# REPLACE_WITH_* placeholder is reported in the UI as "not configured"; the app
# never pretends an unconfigured provider is live.
# ---------------------------------------------------------------------------

# Database (required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/naijadeals_core"
DATABASE_POOL_MIN="1"
DATABASE_POOL_MAX="10"

# App URL used for absolute links and Origin checks (required in production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="local"

# Session cookie (optional; defaults to naijadeals.session)
SESSION_COOKIE_NAME="naijadeals.session"

# Payments ---------------------------------------------------------------
# Paystack: server-side verification and refunds use the secret key only.
PAYSTACK_SECRET_KEY=""
# Flutterwave: server-side verification and refunds use the secret key only.
FLUTTERWAVE_SECRET_KEY=""
# Flutterwave webhook verification hash (Dashboard -> Settings -> Webhooks).
FLUTTERWAVE_WEBHOOK_HASH=""

# Local/test payment provider -------------------------------------------
# Enables a clearly-labelled simulated provider for automated tests and local
# walkthroughs. Ignored when NODE_ENV=production. Never enable in production.
ENABLE_TEST_PAYMENTS="false"
