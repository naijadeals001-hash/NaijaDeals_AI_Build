# NaijaDeals Environment Variables - Example Values Only
# Never commit actual credentials. See .gitignore for excluded files.

DATABASE_URL="postgresql://example:example@localhost:5432/naijadeals_example"
# Required by financial/integration scripts. Must point at a disposable isolated
# database with a TEST marker; there is no fallback to DATABASE_URL.
TEST_DATABASE_URL="postgresql://example:example@localhost:5432/naijadeals_test_example"
# Disputed escrow release is fail-closed. Only set this to true after reviewing
# the refund-aware release acceptance evidence for the deployment.
DISPUTE_RELEASE_ENABLED=""
# NaijaDrive pickup-code protection. Both values are required for driver
# acceptance, rider code retrieval and driver verification; the service fails
# closed with 503 verification_key_unavailable when either is missing. Never
# reuse another secret. Generate each key with: openssl rand -hex 32
# KEY_VERSION selects the key used for NEW records. During rotation add the new
# version's key, point KEY_VERSION at it, and keep the old key configured until
# every record that used it has expired or been invalidated.
DRIVE_PICKUP_VERIFICATION_KEY_VERSION=""
DRIVE_PICKUP_VERIFICATION_KEY_V1=""
DEEPSEEK_API_KEY="sk-your-deepseek-key-here"
OPENAI_API_KEY="sk-your-openai-key-here"
KIE_API_KEY="your-kie-key-here"
# --- Object storage (S3-compatible) ---
# Development uses the local SeaweedFS stack. Staging uses Cloudflare R2 with
# SEPARATE public and private buckets; the application key must be scoped to
# those two buckets only. Never commit real values.
S3_ENDPOINT=
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_BUCKET=
S3_PUBLIC_BUCKET=naijadeals-staging-public
S3_PRIVATE_BUCKET=naijadeals-staging-private
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Encrypted staging backups (Backblaze B2 recovery bucket) ---
# BACKUP_ENCRYPTION_KEY is 32 random bytes, base64. It must be stored
# separately from B2; losing it makes every backup unrecoverable.
BACKUP_ENCRYPTION_KEY=
BACKUP_KEEP=7
BACKUP_STALE_HOURS=36
BACKUP_REMOTE_PREFIX=staging
BACKUP_RESTORE_DIR=
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET=naijadeals-staging-backups
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=

# --- Isolated staging database and restore role ---
# Staging PostgreSQL listens on 127.0.0.1:55432 with its data directory on D:.
# The application role must not create databases; restores use a separate role.
BACKUP_RESTORE_DATABASE_URL=

# Narrow bearer token for the local automation consumer (n8n).
AUTOMATION_CONSUMER_TOKEN=
