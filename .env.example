# NaijaDeals Environment Variables - Example Values Only
# Never commit actual credentials. See .gitignore for excluded files.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/naijadeals_core"
# Required by financial/integration scripts. Must point at a disposable isolated
# database with a TEST marker; there is no fallback to DATABASE_URL.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/naijadeals_test"
DEEPSEEK_API_KEY="sk-your-deepseek-key-here"
OPENAI_API_KEY="sk-your-openai-key-here"
KIE_API_KEY="your-kie-key-here"