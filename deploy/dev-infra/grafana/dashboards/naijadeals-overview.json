{
  "uid": "nd-overview",
  "title": "NaijaDeals — Local Development Overview",
  "tags": ["naijadeals", "dev"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Scrape targets up",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "nd-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(up)", "legendFormat": "targets" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Infrastructure operations per second, by component",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "nd-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (component) (rate(naijadeals_infra_operations_total[5m]))",
          "legendFormat": "{{component}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Queue depth and failures",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "nd-prometheus" },
      "targets": [
        { "refId": "A", "expr": "naijadeals_queue_depth", "legendFormat": "waiting" },
        { "refId": "B", "expr": "naijadeals_queue_failures_total", "legendFormat": "failures" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "nd-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(naijadeals_cache_hits_total[5m]) / clamp_min(rate(naijadeals_cache_requests_total[5m]), 1e-9)",
          "legendFormat": "hit ratio"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] }
    }
  ]
}
