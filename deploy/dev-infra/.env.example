# Copy of the variables consumed by docker-compose.yml.
# Real values live in deploy/dev-infra/.env, which is generated locally and
# gitignored. Never commit an actual secret.

# Valkey
VALKEY_PASSWORD=

# Meilisearch
MEILI_MASTER_KEY=

# pgvector
PGVECTOR_PASSWORD=

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Application side (written into the gitignored root .env by gen-secrets.mjs).
# Shown here for reference only; these are never committed with values.
VALKEY_URL=
MEILISEARCH_URL=
MEILISEARCH_API_KEY=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
VECTOR_DATABASE_URL=
PROMETHEUS_URL=
OSRM_URL=
